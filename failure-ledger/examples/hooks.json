{
  "failure-circuit-breaker": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/failure-interceptor.sh post",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/failure-interceptor.sh pre",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
